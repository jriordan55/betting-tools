{
  "name": "bettor-desktop",
  "version": "0.1.0",
  "description": "Sports betting calculators and simulations",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "rs:test": "cargo test --workspace",
    "rs:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:fmt": "cargo fmt --all",
    "verify": "pnpm rs:lint && pnpm rs:test && pnpm check && pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "d3": "^7.9.0",
    "katex": "^0.18.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
